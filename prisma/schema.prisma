datasource db {
  provider = "postgresql"
}

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

enum Role {
  BUYER
  VENDOR
  ADMIN
}

enum OrderStatus {
  PLACED
  CONFIRMED
  SHIPPED
  DELIVERED
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RefundStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentGateway {
  RAZORPAY
  COD
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id        String   @id @default(uuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  role      Role     @default(BUYER)
  cartData  String?  // JSON-serialized cart state for persistence across sessions
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  store    Store?    @relation("VendorStore")
  orders   Order[]   @relation("BuyerOrders")
  reviews  Review[]
  wishlist Product[] @relation("UserWishlist")
}

model Store {
  id          String       @id @default(uuid())
  name        String
  description String?
  logo        String?      // ImageKit URL
  location    String       // Hyperlocal location tag/coordinates
  status      VendorStatus @default(PENDING)
  commission  Float        @default(10.0) // Platform commission percentage
  vendorId    String       @unique
  vendor      User         @relation("VendorStore", fields: [vendorId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Vendor trust & verification (Phase 3)
  gstNumber          String?
  panNumber          String?
  bankAccountNumber  String?             // AES-256-GCM encrypted at rest, see src/lib/crypto.ts
  bankIfsc           String?
  verificationStatus VerificationStatus  @default(UNVERIFIED)
  verificationNotes  String?

  products Product[]
  payouts  Payout[]

  @@index([status])
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String
  price       Float
  stock       Int      @default(0)
  images      String[] // Array of ImageKit URLs
  category    String
  subCategory String?
  location    String?  // Copied from store for fast geolocation filtering
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // Relationships
  reviews      Review[]
  orderItems   OrderItem[]
  wishlistedBy User[]      @relation("UserWishlist")

  @@index([category])
  @@index([price])
  @@index([createdAt])
  @@index([storeId])
  @@index([storeId, category])
  @@index([name])
}

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique
  status      OrderStatus @default(PLACED)
  totalAmount Float
  netAmount   Float       // Amount after commission is deducted
  address     String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  paymentStatus     PaymentStatus   @default(PENDING)
  paymentGateway    PaymentGateway?
  razorpayOrderId   String?         @unique
  razorpayPaymentId String?         @unique
  razorpaySignature String?

  buyerId String
  buyer   User   @relation("BuyerOrders", fields: [buyerId], references: [id])

  orderItems OrderItem[]
  refund     Refund?

  @@index([buyerId])
  @@index([status])
  @@index([buyerId, status])
  @@index([createdAt])
  @@index([paymentStatus])
}

model OrderItem {
  id        String @id @default(uuid())
  quantity  Int
  price     Float  // Price at which product was purchased
  productId String
  product   Product @relation(fields: [productId], references: [id])
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  review Review?

  @@index([productId])
  @@index([orderId])
}

model Review {
  id        String   @id @default(uuid())
  rating    Int      @default(5)
  comment   String?
  createdAt DateTime @default(now())

  buyerId   String
  buyer     User     @relation(fields: [buyerId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])

  orderItemId String?    @unique
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@unique([buyerId, productId])
}

model Refund {
  id          String       @id @default(uuid())
  reason      String
  status      RefundStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  orderId     String       @unique
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Payout {
  id        String   @id @default(uuid())
  amount    Float
  createdAt DateTime @default(now())

  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([createdAt])
}

// Immutable trail of every admin-privileged mutation (store approval, refund
// decisions, role changes, verification decisions, payouts). Never updated or
// deleted after creation.
model AdminAuditLog {
  id           String   @id @default(uuid())
  adminUserId  String
  action       String   // e.g. "STORE_APPROVE", "REFUND_REJECT", "ROLE_CHANGE"
  targetType   String   // e.g. "Store", "Refund", "User", "Payout"
  targetId     String
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([adminUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
}
